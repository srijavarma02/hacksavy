# Twilio Configuration
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Configuration (optional)
# For testing, use Twilio sandbox: whatsapp:+14155238886
# For production, use your approved WhatsApp Business number
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Featherless.ai Configuration
# Get your API key from: https://featherless.ai/account/api-keys
FEATHERLESS_API_KEY=your_featherless_api_key_here
# Optional: override the default model (see https://featherless.ai/models)
FEATHERLESS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Application Configuration
NODE_ENV=development
PORT=8080

# Instructions:
# 1. Copy this file to .env
# 2. Sign up at https://www.twilio.com/try-twilio
# 3. Get your Account SID and Auth Token from the Twilio Console
# 4. Buy a phone number or use trial number
# 5. Update the phone numbers in server/notificationService.js with your real numbers
# 6. For trial accounts, verify recipient phone numbers in Twilio Console
